# Hedera network: local | testnet
HEDERA_NETWORK=testnet

# Operator account from https://portal.hedera.com
# IMPORTANT: create the account with key type ECDSA (not ED25519) — the same
# key is reused to deploy the EVM contract via Hardhat.
#
# OPERATOR_ID  = the "Account ID" field, e.g. 0.0.123456
# OPERATOR_KEY = the "HEX Encoded Private Key": 64 hex chars, 0x-prefixed.
#                This is the SAME value as contracts/.env OPERATOR_EVM_PRIVATE_KEY.
OPERATOR_ID=
OPERATOR_KEY=

# Filled in after running the create scripts
LOAN_TOKEN_ID=
CREDIT_TOPIC_ID=
